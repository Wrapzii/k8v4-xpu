d: list[tuple[int, int]] = []\n    for start, end in sorted_intervals:\n        if not merged:\n            merged.append((start, end))\n        else:\n            prev_start, prev_end = merged[-1]\n            # Merge if overlapping or touching: next_start <= previous_end\n            if start <= prev_end:\n                # Update the end of the last merged interval\n                merged[-1] = (prev_start, max(prev_end, end))\n            else:\n                merged.append((start, end))\n\n    return merged", "events": [{"t": 4.756753719993867, "tokens": 0, "prompt_tokens": 8190}, {"t": 4.756877900988911, "tokens": 1, "prompt_tokens": 8190}, {"t": 4.788033288990846, "tokens": 8, "prompt_tokens": 8190}, {"t": 4.826745938989916, "tokens": 15, "prompt_tokens": 8190}, {"t": 4.866322930000024, "tokens": 19, "prompt_tokens": 8190}, {"t": 4.905278619989986, "tokens": 24, "prompt_tokens": 8190}, {"t": 4.944260530988686, "tokens": 31, "prompt_tokens": 8190}, {"t": 4.983299040992279, "tokens": 35, "prompt_tokens": 8190}, {"t": 5.022388301993487, "tokens": 42, "prompt_tokens": 8190}, {"t": 5.061059061990818, "tokens": 46, "prompt_tokens": 8190}, {"t": 5.100504923000699, "tokens": 50, "prompt_tokens": 8190}, {"t": 5.140228614996886, "tokens": 55, "prompt_tokens": 8190}, {"t": 5.179281094999169, "tokens": 62, "prompt_tokens": 8190}, {"t": 5.218269694989431, "tokens": 69, "prompt_tokens": 8190}, {"t": 5.257602685989696, "tokens": 76, "prompt_tokens": 8190}, {"t": 5.296551266990718, "tokens": 82, "prompt_tokens": 8190}, {"t": 5.3361060280003585, "tokens": 88, "prompt_tokens": 8190}, {"t": 5.375327008994645, "tokens": 91, "prompt_tokens": 8190}, {"t": 5.414190438998048, "tokens": 98, "prompt_tokens": 8190}, {"t": 5.453358259997913, "tokens": 105, "prompt_tokens": 8190}, {"t": 5.492583120998461, "tokens": 112, "prompt_tokens": 8190}, {"t": 5.531669360992964, "tokens": 117, "prompt_tokens": 8190}, {"t": 5.571249151995289, "tokens": 121, "prompt_tokens": 8190}, {"t": 5.609999312