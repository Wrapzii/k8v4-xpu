# Compiler image for the two SYCL libraries. Does not use the GPU.
# icpx 2025.3 segfaults in dlopen against this vLLM image's libsycl.so.9.
# vLLM 0.34 ships the 2026.1.2 SYCL runtime (intel_sycl_rt 2026.1.2); the
# newest published devel image of that line is 2026.1.0.
FROM vllm/vllm-openai-xpu:v0.34.0@sha256:cb55d8cffeb1851c552c4b002a5e8be21daa99a51a678d53c57f271e7c16b3f0
COPY --from=intel/oneapi:2026.1.0-devel-ubuntu24.04 /opt/intel/oneapi /opt/intel-2026/oneapi
